    "pretty-bytes": "^7.1.1",
    "text-case": "^1.2.11",
    "vue": "^3.5.41",
    "vue-pdf-embed": "^2.1.5",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.7",
    "xior": "^0.8.4"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@pinia/testing": "^2.0.1",
