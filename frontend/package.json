{
  "name": "codex",
  "version": "2.5.8",
  "private": true,
  "description": "ui for codex api",
  "type": "module",
  "scripts": {
    "analyze": "vite build --mode analyze",
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "dev": "vite dev",
    "devBuild": "vite build --mode development",
    "fix": "eslint_d --cache --fix . && prettier --write .",
    "lint": "eslint_d --cache . && prettier --check .",
    "test": "vitest --reporter verbose",
    "test:ci": "vitest run --reporter verbose",
    "test:update": "vitest run --update"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "dequal": "^2.0.3",
    "eslint-import-resolver-oxc": "^0.15.0",
    "pinia": "^4.1.0",
    "pretty-bytes": "^7.2.0",
    "text-case": "^1.2.11",
    "vue": "^3.5.44",
    "vue-pdf-embed": "^2.1.7",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1",
    "xior": "^0.8.5"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@pinia/testing": "^2.0.2",
    "@types/node": "^26.6.6",
    "@unhead/bundler": "^3.4.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/typescript-plugin": "^3.3.14",
    "happy-dom": "^21.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.107.0",
    "sass-loader": "^17.1.0",
    "toml": "^5.0.1",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dynamic-base": "^1.4.1",
    "vite-plugin-run": "^0.9.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
